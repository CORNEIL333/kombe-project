# KÓMBE — exemple d'environnement de déploiement. Copier en `.env` (jamais
# versionné : .gitignore exclut `.env*`). Aucun secret réel ici : ce sont des
# valeurs de DÉVELOPPEMENT local ; en production, fournir mot de passe et hôtes
# hors bande (secrets manager / variables d'environnement de l'hébergeur).

# ── API ──────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── PostgreSQL (déploiement local via docker-compose) ────────────────────────
POSTGRES_USER=kombe
POSTGRES_PASSWORD=kombe_dev_only
POSTGRES_DB=kombe

# Chaîne de connexion du runner de migration (rôle migrateur/propriétaire).
# En docker-compose, l'hôte est `postgres` ; en local direct, `localhost`.
KOMBE_DATABASE_URL=postgresql://kombe:kombe_dev_only@postgres:5432/kombe

# Chaîne de connexion de la base de TEST isolée (preuves base réelle C01 :
# RLS/verrous/pool). La base kombe_test est créée par provision/docker-init.sql.
KOMBE_TEST_DATABASE_URL=postgresql://kombe:kombe_dev_only@postgres:5432/kombe_test

# ── D04 : email transactionnel (Resend, décision humaine 2026-10-06) ────────
# Jamais de clé réelle ici. En local : copier dans .env (gitignored). En
# production : fournie par le gestionnaire de secrets de l'hébergeur (Vercel).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Expéditeur Resend. Sans domaine vérifié, seul `onboarding@resend.dev` (test,
# ne livre qu'à l'adresse du compte Resend) fonctionne — défaut si absente.
KOMBE_EMAIL_FROM=KÓMBE <onboarding@resend.dev>

# ── API ──────────────────────────────────────────────────────────────────────
# Absente ⇒ API en repli FICTIF explicite (recette squelette uniquement, jamais
# servi en production). Posée ⇒ API 100% RÉELLE : tous les stores métier sont
# PostgreSQL (Pg*Store), l'identité vient de la session Bearer résolue serveur
# (jamais d'en-tête x-actor), les routes sans implémentation PG réelle n'existent
# pas (404). Rôle applicatif `kombe_app` (jamais le propriétaire/migrateur).
KOMBE_API_DATABASE_URL=postgresql://kombe:kombe_dev_only@postgres:5432/kombe

# ── §20/§25 : gardes HTTP (CORS + débit) ─────────────────────────────────────
# Origines front AUTORISÉES, séparées par des virgules, https:// ou http://
# (http:// réservé au dev local). Liste fermée : une origine absente de la
# liste reçoit un preflight 403 et aucun en-tête CORS. Défaut si absente :
# aucune origine autorisée (le navigateur bloque tout partage croisé — explicite).
# Exemple production : https://<pwa>.vercel.app,https://<admin>.vercel.app,https://<dash>.pages.dev
KOMBE_CORS_ORIGINS=https://localhost:5173,http://localhost:5173
KOMBE_RATE_LIMIT_GLOBAL=120
KOMBE_RATE_LIMIT_AUTH=10

# ── Worker outbox (C13) ─────────────────────────────────────────────────────
# OBLIGATOIRE pour le worker : pas de mode fictif (échec franc au démarrage
# si absente). Rôle `kombe_worker` : consommateur outbox sous RLS, découverte
# des groupes via kombe_c13_pending_groups() (migration 0023).
KOMBE_WORKER_DATABASE_URL=postgresql://kombe:kombe_dev_only@postgres:5432/kombe
# Santé HTTP du worker (127.0.0.1 uniquement) : GET /health → 200 ok / 503 degraded.
WORKER_PORT=3001
# Fréquence de scrutation de l'outbox en ms (bornes 50..60000).
WORKER_POLL_MS=1000
