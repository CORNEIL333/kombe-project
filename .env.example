# KÓMBE — exemple d'environnement de déploiement. Copier en `.env` (jamais
# versionné : .gitignore exclut `.env*`). Aucun secret réel ici : ce sont des
# valeurs de DÉVELOPPEMENT local ; en production, fournir mot de passe et hôtes
# hors bande (secrets manager / variables d'environnement de l'hébergeur).

# ── API ──────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── PostgreSQL (déploiement local via docker-compose) ────────────────────────
POSTGRES_USER=kombe
POSTGRES_PASSWORD=kombe_dev_only
POSTGRES_DB=kombe

# Chaîne de connexion du runner de migration (rôle migrateur/propriétaire).
# En docker-compose, l'hôte est `postgres` ; en local direct, `localhost`.
KOMBE_DATABASE_URL=postgresql://kombe:kombe_dev_only@postgres:5432/kombe

# Chaîne de connexion de la base de TEST isolée (preuves base réelle C01 :
# RLS/verrous/pool). La base kombe_test est créée par provision/docker-init.sql.
KOMBE_TEST_DATABASE_URL=postgresql://kombe:kombe_dev_only@postgres:5432/kombe_test

# ── D04 : email transactionnel (Resend, décision humaine 2026-10-06) ────────
# Jamais de clé réelle ici. En local : copier dans .env (gitignored). En
# production : fournie par le gestionnaire de secrets de l'hébergeur (Vercel).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Expéditeur Resend. Sans domaine vérifié, seul `onboarding@resend.dev` (test,
# ne livre qu'à l'adresse du compte Resend) fonctionne — défaut si absente.
KOMBE_EMAIL_FROM=KÓMBE <onboarding@resend.dev>

# ── Piste A3 : mode RÉEL de l'API (connexion + cotisation sur Postgres) ─────
# Absente ⇒ API 100% fictive (défaut). Posée ⇒ server.ts active PgAccessStore/
# PgContributionStore + authentification par session réelle pour CE périmètre
# seulement (voir packages/api/src/server.ts, BuildAppOptions.pool). Rôle
# applicatif `kombe_app` (jamais le propriétaire/migrateur).
KOMBE_API_DATABASE_URL=postgresql://kombe:kombe_dev_only@postgres:5432/kombe
