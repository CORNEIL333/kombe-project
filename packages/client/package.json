{
  "name": "@kombe/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KÓMBE — client web PWA (React + Vite). Gate C00 ouvert par C14 : le build (Vite) et la recette E2E (Playwright) sont raccordés et réellement exécutés. Le UI accompagne les incréments métier ; aucune promesse de garantie des fonds, aucune cryptographie/log technique dans le parcours ordinaire.",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kombe/dashboard-core": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
