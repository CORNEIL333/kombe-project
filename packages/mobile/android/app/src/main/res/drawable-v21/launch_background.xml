<?xml version="1.0" encoding="utf-8"?>
<!-- KÓMBE : écran natif de lancement (fond sable + symbole de la charte),
     relayé sans coupure par l'ouverture animée Flutter (KombeOuverture). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/kombe_sable" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
